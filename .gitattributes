# Normalisation automatique
* text=auto

# Code source C#
*.cs text eol=crlf
*.vb text eol=crlf

# Fichiers projet Visual Studio
*.csproj text eol=crlf
*.vbproj text eol=crlf
*.sln text eol=crlf
*.resx text eol=crlf
*.rdlc text eol=crlf

# Config
*.config text eol=crlf
*.xml text eol=crlf
*.xsd text eol=crlf

# Web
*.html text eol=crlf
*.css text eol=crlf
*.js text eol=crlf

# Texte
*.md text eol=lf
*.txt text eol=lf
*.json text eol=lf

# Binaires — pas de conversion
*.dll binary
*.exe binary
*.msi binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.bmp binary
*.pdf binary
*.zip binary
*.nupkg binary
*.snk binary
*.pfx binary
*.olb binary